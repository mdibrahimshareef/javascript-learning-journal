/**
 * Challenge: Truncate a String
 * Concepts: String Manipulation, String.prototype.slice(), Conditional Logic
 * 
 * Logic:
 * - If string length exceeds `num`, trim characters from index 0 to `num`
 *   and append ellipsis ('...').
 * - If string length is less than or equal to `num`, return original string.
 */

function truncateString(str, num) {
  // Check if string needs to be shortened
  if (str.length > num) {
    return str.slice(0, num) + "...";
  }

  // Otherwise return string as-is
  return str;
}

// -------------------------------------------------------------
// Verification Checks
// -------------------------------------------------------------
console.log(truncateString("A-tisket a-tasket A green and yellow basket", 8));
// Output: "A-tisket..."

console.log(truncateString("Peter Piper picked a peck of pickled peppers", 11));
// Output: "Peter Piper..."

console.log(truncateString("A-tisket a-tasket A green and yellow basket", 43));
// Output: "A-tisket a-tasket A green and yellow basket"

console.log(truncateString("A-", 1));
// Output: "A..."
